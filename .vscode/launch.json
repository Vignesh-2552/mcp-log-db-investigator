{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Investigation server (HTTP)",
      "type": "debugpy",
      "request": "launch",
      "module": "opsinsight.server",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": true,
      "python": "${command:python.interpreterPath}"
    },
    {
      "name": "Investigation server (stdio)",
      "type": "debugpy",
      "request": "launch",
      "module": "opsinsight.server",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": true,
      "python": "${command:python.interpreterPath}",
      "env": {
        "MCP_TRANSPORT": "stdio"
      }
    },
    {
      "name": "Pytest: current file",
      "type": "debugpy",
      "request": "launch",
      "module": "pytest",
      "args": ["${file}", "-m", "not integration", "-q"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": false,
      "python": "${command:python.interpreterPath}"
    }
  ]
}
