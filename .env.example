# Copy to .env and fill in your PostgreSQL connection details.

# Database — provide your full PostgreSQL connection URL (asyncpg driver)
DB_URL=postgresql+asyncpg://user:password@host:5432/dbname
DB_MAX_ROWS=500
DB_STATEMENT_TIMEOUT_MS=15000
DB_IDLE_TXN_TIMEOUT_MS=30000
DB_MAX_CELL_BYTES=4096
# Total size cap on rows one DB tool call returns (extra rows dropped, meta.truncated=true)
DB_MAX_RESPONSE_BYTES=1000000
# DB tool calls running at once; more wait DB_QUEUE_TIMEOUT_S, then fail with `server_busy`
DB_MAX_CONCURRENT_QUERIES=4
DB_QUEUE_TIMEOUT_S=5
DB_SCHEMA_CACHE_TTL_S=600

# AWS / CloudWatch — CLOUDWATCH_REGION is required (there is no AWS_REGION
# fallback; plain AWS_ACCESS_KEY_ID/AWS_SECRET_ACCESS_KEY in .env are NOT
# read by this app either). Authenticate via either AWS_PROFILE (a boto3
# profile name) or CLOUDWATCH_ACCESS_KEY_ID + CLOUDWATCH_SECRET_ACCESS_KEY.
CLOUDWATCH_REGION=ap-south-1
AWS_PROFILE=mcp-readonly
# CLOUDWATCH_ACCESS_KEY_ID=
# CLOUDWATCH_SECRET_ACCESS_KEY=
# CLOUDWATCH_ALLOWED_LOG_GROUP=      # comma-separated list of allowed log group name(s)
CW_MAX_WINDOW_HOURS=168
CW_DEFAULT_WINDOW_HOURS=24
CW_MAX_BYTES_SCANNED=5000000000
CW_POLL_MAX_WAIT_S=60
CW_MAX_RESPONSE_BYTES=1000000

# New Relic (NerdGraph / NRQL) — User API key (NRAK-...), not an ingest/license key
NEW_RELIC_API_KEY=
NEW_RELIC_ACCOUNT_ID=
NEW_RELIC_REGION=us
NR_MAX_WINDOW_HOURS=168
NR_DEFAULT_WINDOW_HOURS=24

# Ticket systems (ticket_* tools, read-only). Configure Linear, Jira Cloud, or both.
# TICKET_PROVIDER=auto: the one configured; with both, each call must pass `provider`.
# These keys carry the user's full permissions; prefer a dedicated service account.
TICKET_PROVIDER=auto
# LINEAR_API_KEY=            # Linear personal API key (lin_api_...)
# JIRA_BASE_URL=https://your-org.atlassian.net   # must be https://
# JIRA_EMAIL=                # Atlassian account email for the API token
# JIRA_API_TOKEN=            # https://id.atlassian.com/manage-profile/security/api-tokens
TICKET_MAX_RESULTS=50                # search / comment page clamp (max 100)
TICKET_MAX_RESPONSE_BYTES=1000000
TICKET_MAX_DESCRIPTION_BYTES=32768   # per description / comment body
TICKET_HTTP_TIMEOUT_S=15
NR_MAX_ROWS=500
NR_MAX_RESPONSE_BYTES=1000000

# trace_request (one identifier across CloudWatch + New Relic + DB).
# Each can be overridden per call. A source with nothing configured is skipped.
# TRACE_CW_LOG_GROUPS=          # comma-separated; empty = all of CLOUDWATCH_ALLOWED_LOG_GROUP
TRACE_CW_FIELD=requestId
TRACE_NR_EVENT_TYPE=Log
TRACE_NR_FIELD=requestId
# TRACE_DB_ID_TYPE=order_id     # DB column to search; empty = DB skipped unless passed per call
TRACE_SOURCE_TIMEOUT_S=60
TRACE_MAX_EVENTS=500
TRACE_MAX_RESPONSE_BYTES=1000000

# Server
# Loopback by default. A non-loopback SERVER_HOST refuses to start unless
# MCP_AUTH_TOKEN is set (min 32 chars; python -c "import secrets; print(secrets.token_urlsafe(32))")
# or ALLOW_UNAUTHENTICATED_HTTP=true (only behind an authenticating proxy).
SERVER_HOST=127.0.0.1
# MCP_AUTH_TOKEN=
# ALLOW_UNAUTHENTICATED_HTTP=false
# Hostnames/Origins accepted besides localhost (DNS-rebinding guard), comma-separated:
# SERVER_ALLOWED_HOSTS=mcp.example.com
# SERVER_ALLOWED_ORIGINS=https://mcp.example.com
SERVER_PORT=8001      # ignored if $PORT is set by the host platform (Render/Railway/Fly) and
                       # this var is left unset — see core/config.py
SERVER_PATH=/mcp
# Request rate limit across all clients (token bucket). RATE_LIMIT_RPS=0 disables it.
RATE_LIMIT_RPS=5
RATE_LIMIT_BURST=20
PII_REDACTION=true

# Response cache: memory (per process, default) | redis (shared across replicas
# and restarts; install `opsinsight-mcp[redis]`) | none. Caches only successful,
# redacted responses for stable data: table/column metadata, log groups, NR event
# types/attributes, and CloudWatch Insights results for windows that have closed.
CACHE_BACKEND=memory
# REDIS_URL=rediss://:password@redis.internal:6379/0   # rediss:// = TLS
# REDIS_SOCKET_TIMEOUT_S=0.5
# CACHE_RETRY_AFTER_S=30          # after a Redis error, run uncached for this long
CACHE_METADATA_TTL_S=600          # 0 disables metadata caching
CW_RESULT_CACHE_TTL_S=3600        # 0 disables Insights result caching
CW_RESULT_CACHE_SETTLE_S=300      # window must have ended this long ago to be cached
