# Copy to .env and fill in your PostgreSQL connection details.

# Database — provide your full PostgreSQL connection URL (asyncpg driver)
DB_URL=postgresql+asyncpg://user:password@host:5432/dbname
DB_MAX_ROWS=500
DB_STATEMENT_TIMEOUT_MS=15000
DB_IDLE_TXN_TIMEOUT_MS=30000
DB_MAX_CELL_BYTES=4096
DB_SCHEMA_CACHE_TTL_S=600

# AWS — either AWS_PROFILE, or AWS_ACCESS_KEY_ID + AWS_SECRET_ACCESS_KEY.
# If both are set, the explicit access key/secret take priority over the profile.
AWS_REGION=ap-south-1
AWS_PROFILE=mcp-readonly
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
CW_LOG_GROUP_ALLOWLIST=/aws/ecs/checkout-svc,/aws/ecs/payment-svc,/aws/lambda/webhook
CW_MAX_WINDOW_HOURS=168
CW_DEFAULT_WINDOW_HOURS=24
CW_MAX_BYTES_SCANNED=5000000000
CW_POLL_MAX_WAIT_S=60

# New Relic (NerdGraph / NRQL) — User API key (NRAK-...), not an ingest/license key
NEW_RELIC_API_KEY=
NEW_RELIC_ACCOUNT_ID=
NEW_RELIC_REGION=us
NR_MAX_WINDOW_HOURS=168
NR_DEFAULT_WINDOW_HOURS=24
NR_MAX_ROWS=500

# Server
SERVER_HOST=0.0.0.0
SERVER_PORT=8000
SERVER_PATH=/mcp
PII_REDACTION=true
