# Copy to .env and fill in your PostgreSQL connection details.

# Database — provide your full PostgreSQL connection URL (asyncpg driver)
DB_URL=postgresql+asyncpg://user:password@host:5432/dbname
DB_MAX_ROWS=500
DB_STATEMENT_TIMEOUT_MS=15000
DB_IDLE_TXN_TIMEOUT_MS=30000
DB_MAX_CELL_BYTES=4096
DB_SCHEMA_CACHE_TTL_S=600

# AWS / CloudWatch — CLOUDWATCH_REGION is required (there is no AWS_REGION
# fallback; plain AWS_ACCESS_KEY_ID/AWS_SECRET_ACCESS_KEY in .env are NOT
# read by this app either). Authenticate via either AWS_PROFILE (a boto3
# profile name) or CLOUDWATCH_ACCESS_KEY_ID + CLOUDWATCH_SECRET_ACCESS_KEY.
CLOUDWATCH_REGION=ap-south-1
AWS_PROFILE=mcp-readonly
# CLOUDWATCH_ACCESS_KEY_ID=
# CLOUDWATCH_SECRET_ACCESS_KEY=
# CLOUDWATCH_ALLOWED_LOG_GROUP=      # comma-separated list of allowed log group name(s)
CW_MAX_WINDOW_HOURS=168
CW_DEFAULT_WINDOW_HOURS=24
CW_MAX_BYTES_SCANNED=5000000000
CW_POLL_MAX_WAIT_S=60

# New Relic (NerdGraph / NRQL) — User API key (NRAK-...), not an ingest/license key
NEW_RELIC_API_KEY=
NEW_RELIC_ACCOUNT_ID=
NEW_RELIC_REGION=us
NR_MAX_WINDOW_HOURS=168
NR_DEFAULT_WINDOW_HOURS=24
NR_MAX_ROWS=500

# Server
# Loopback by default because the MCP HTTP transport has no built-in authentication.
# Only bind externally when access is protected by an authenticated proxy or firewall.
SERVER_HOST=127.0.0.1
SERVER_PORT=8001      # ignored if $PORT is set by the host platform (Render/Railway/Fly) and
                       # this var is left unset — see core/config.py
SERVER_PATH=/mcp
PII_REDACTION=true
