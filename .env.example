# Copy to .env and adjust as needed. Defaults below point at the local
# docker-compose Postgres (see docker-compose.yml) so `docker compose up -d`
# + `uv run server.py` works out of the box with zero real infra.

# Database
DB_HOST=localhost
DB_PORT=55432
DB_NAME=appdb
DB_USER=mcp_ro
DB_PASSWORD=mcp_ro
DB_TABLE_ALLOWLIST=public.orders,public.users,public.payments,public.audit_events
DB_MAX_ROWS=500
DB_STATEMENT_TIMEOUT_MS=15000
DB_IDLE_TXN_TIMEOUT_MS=30000
DB_MAX_CELL_BYTES=4096
DB_SCHEMA_CACHE_TTL_S=600

# AWS
AWS_REGION=ap-south-1
AWS_PROFILE=mcp-readonly
CW_LOG_GROUP_ALLOWLIST=/aws/ecs/checkout-svc,/aws/ecs/payment-svc,/aws/lambda/webhook
CW_MAX_WINDOW_HOURS=168
CW_DEFAULT_WINDOW_HOURS=24
CW_MAX_BYTES_SCANNED=5000000000
CW_POLL_MAX_WAIT_S=60

# Server
AUDIT_LOG_PATH=./audit.jsonl
PII_REDACTION=true
