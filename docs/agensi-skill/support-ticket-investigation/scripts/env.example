# Placeholders only. Fill in the sources you use and keep this file out of version control.
# Only needed for the Docker or run-from-source setups. With uvx, put these values in the
# MCP client config's "env" block instead (see mcp-config.example.json).
# In Docker, AWS_PROFILE does not work (no ~/.aws in the container): use the access-key pair.

# Database: a read-only role (asyncpg driver)
DB_URL=postgresql+asyncpg://readonly_user:CHANGE_ME@host:5432/dbname
DB_MAX_ROWS=500
DB_STATEMENT_TIMEOUT_MS=15000

# CloudWatch: CLOUDWATCH_REGION is required. Use AWS_PROFILE or the access-key pair, not both.
CLOUDWATCH_REGION=us-east-1
AWS_PROFILE=readonly-profile
# CLOUDWATCH_ACCESS_KEY_ID=
# CLOUDWATCH_SECRET_ACCESS_KEY=
# CLOUDWATCH_ALLOWED_LOG_GROUP=   # comma-separated allowlist
CW_MAX_WINDOW_HOURS=168
CW_MAX_BYTES_SCANNED=5000000000

# New Relic: User API key (NRAK-...)
NEW_RELIC_API_KEY=
NEW_RELIC_ACCOUNT_ID=
NEW_RELIC_REGION=us

# Server (HTTP mode only): loopback by default. For Docker, the run command overrides
# these with -e SERVER_HOST=0.0.0.0 -e SERVER_PORT=8000.
SERVER_HOST=127.0.0.1
SERVER_PORT=8001
SERVER_PATH=/mcp
PII_REDACTION=true
